{
  "name": "obelisks-tormentor-website",
  "compatibility_date": "2026-09-09",
  // The Worker fronts the static assets so /api/listening/* is handled before
  // anything is served. Unreleased audio lives in KV and never in ./dist, which
  // is world-readable the moment it deploys.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this the Worker never runs for the API. Assets are served first,
    // and in single-page-application mode the asset layer answers *every*
    // unmatched path with index.html — so POST /api/listening/session came back
    // as HTML with a 200, and the page failed trying to parse it as JSON.
    "run_worker_first": ["/api/*"]
  },
  // Holds both the invitations and the audio itself (under an "audio:" prefix).
  // R2 would be the better store, but enabling it requires a payment method on
  // the account even within the free tier; KV needs neither, and its 25 MB
  // per-value limit is several times what a 128 kbps preview takes.
  "kv_namespaces": [
    { "binding": "INVITES", "id": "94bbfda9ddf74ec99dfecdfaafbec25d" }
  ]
  // If R2 is ever enabled, add the block below and the Worker prefers it
  // automatically — no code change, and existing KV audio keeps working:
  //
  // "r2_buckets": [
  //   { "binding": "PRIVATE_AUDIO", "bucket_name": "obelisk-private-audio" }
  // ]
  //
  // SESSION_SECRET is set with `wrangler secret put SESSION_SECRET`, never here.
}
