{
  "name": "obelisks-tormentor-website",
  "compatibility_date": "2026-09-09",
  // The Worker now fronts the static assets so /api/listening/* can be handled
  // before anything is served. Unreleased audio lives in the private R2 bucket
  // below and never in ./dist, which is world-readable once deployed.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Commented out until the bucket and namespace actually exist in the account.
  // Deploying with a binding that points at nothing fails the whole deploy, and
  // since this Worker now serves every page, that would block all site updates.
  // Un-comment both blocks after running the commands in PANDUAN.md, and paste
  // the printed namespace id over the placeholder below.
  //
  // "r2_buckets": [
  //   { "binding": "PRIVATE_AUDIO", "bucket_name": "obelisk-private-audio" }
  // ],
  // "kv_namespaces": [
  //   { "binding": "INVITES", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  // ]
  // SESSION_SECRET is set with `wrangler secret put SESSION_SECRET`, never here.
}
